# SGI v2 — contrato de configuração local/Docker
# Copie para .env e ajuste segredos, URLs e tokens antes de subir o ambiente.
# Nunca versione o arquivo .env real.

# -----------------------------------------------------------------------------
# Ambiente e exposição Docker
# -----------------------------------------------------------------------------
ENVIRONMENT=development
APP_DEBUG=false
APP_PORT=80
BACKEND_PORT=8000

# SHA completo usado como metadata da imagem. Antes do build, prefira:
# export APP_COMMIT_SHA="$(git rev-parse HEAD)"
APP_COMMIT_SHA=unknown

# Vazio usa o proxy Nginx /api -> backend:8000.
VITE_API_URL=

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=sgi
POSTGRES_PASSWORD=sgi
POSTGRES_DB=sgi
DATABASE_URL=postgresql://sgi:sgi@db:5432/sgi
ASYNC_DATABASE_URL=postgresql+asyncpg://sgi:sgi@db:5432/sgi

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Autenticação, CORS e rate limiting
# Em production, SECRET_KEY deve ter ao menos 32 caracteres e as credenciais
# padrão de SuperAdmin são rejeitadas pela aplicação.
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute

SUPERADMIN_EMAIL=admin@sig.local
SUPERADMIN_PASSWORD=Admin@1234!
SUPERADMIN_NAME=Super Admin

# Usadas somente pelo script legado backend/seed_admin.py.
ADMIN_EMAIL=admin@sgi.local
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# -----------------------------------------------------------------------------
# Dados de mercado
# BRAPI_* e ALPHA_VANTAGE_API_KEY são os nomes preferenciais atuais.
# QUOTES_PROVIDER_TOKEN, MARKET_DATA_* e INTL_DATA_KEY são aliases compatíveis.
# -----------------------------------------------------------------------------
BRAPI_TOKEN=
BRAPI_BASE_URL=https://brapi.dev/api
BRAPI_RATE_LIMIT=2.0
BRAPI_RATE_BURST=5
ALPHA_VANTAGE_API_KEY=

QUOTES_PROVIDER_TOKEN=
MARKET_DATA_BASE_URL=
MARKET_DATA_RATE_LIMIT=2.0
MARKET_DATA_RATE_BURST=5
INTL_DATA_KEY=

# -----------------------------------------------------------------------------
# Bootstrap global system-bootstrap.v4
# O startup automático deve ficar desligado por padrão. Informe o SHA completo
# da stable-15jun em cada execução auditável.
# Os dois gates permanecem false até autorização operacional explícita.
# -----------------------------------------------------------------------------
ENABLE_BOOT_MARKET_SYNC=false
SGI_BOOTSTRAP_COMMIT_SHA=
SGI_BOOTSTRAP_ENABLE_DIVIDENDS=false
SGI_BOOTSTRAP_ENABLE_CORPORATE_EVENTS=false

# -----------------------------------------------------------------------------
# Backup, exportação, restore e limpeza controlada de pré-produção
# Configure apenas durante a operação correspondente.
# -----------------------------------------------------------------------------
PRE_PROD_BRANCH=stable-15jun
PRE_PROD_COMMIT_SHA=
PRE_PROD_RESTORE_DATABASE_URL=
PRE_PROD_SYNC_DATABASE_URL=
