# ──────────────────────────────────────────────────────────────────────
# SGI — Sistema de Gerenciamento de Investimentos
# Copie este arquivo para .env e ajuste os valores
# ──────────────────────────────────────────────────────────────────────

# Banco de dados PostgreSQL
POSTGRES_USER=sgi
POSTGRES_PASSWORD=sgi
POSTGRES_DB=sgi

# URLs de conexão (usadas pelo backend)
DATABASE_URL=postgresql://sgi:sgi@db:5432/sgi
ASYNC_DATABASE_URL=postgresql+asyncpg://sgi:sgi@db:5432/sgi

# JWT — troque em produção!
SECRET_KEY=dev-secret-key-troque-em-producao

# Dados de mercado
QUOTES_PROVIDER_TOKEN=
MARKET_DATA_BASE_URL=
MARKET_DATA_RATE_LIMIT=2.0
MARKET_DATA_RATE_BURST=5

# Fonte complementar para ativos internacionais
INTL_DATA_KEY=

# Porta exposta pelo frontend (default: 80)
APP_PORT=80

# ============================================================================
# Dividendos FIIs — bootstrap e sync
# ============================================================================
# O endpoint de dividendos de FIIs exige autenticação e aceita no máximo
# 20 símbolos por chamada.
#
# Para habilitar o bootstrap automático no startup:
#   ENABLE_DIVIDENDS_SYNC=true
#   DIVIDENDS_BOOTSTRAP_ON_STARTUP=true
#
# Escopo inicial: apenas ativos do tipo FII já existentes no banco.

ENABLE_DIVIDENDS_SYNC=false
DIVIDENDS_BOOTSTRAP_ON_STARTUP=false
DIVIDENDS_BOOTSTRAP_START_DATE=2018-01-01
DIVIDENDS_SYNC_LOOKBACK_DAYS=7
DIVIDENDS_BATCH_SIZE=20
