# =============================================
# SIG v2 - Variáveis de Ambiente
# Copie este arquivo para .env e preencha
# =============================================

# --- PostgreSQL ---
POSTGRES_USER=sig_user
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=sig_v2
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sig_user:sua_senha_aqui@db:5432/sig_v2

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
SECRET_KEY=troque-por-uma-chave-segura-de-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- BRAPI ---
BRAPI_TOKEN=seu_token_brapi_aqui
BRAPI_BASE_URL=https://brapi.dev/api

# --- Google Gemini ---
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-1.5-pro

# --- App ---
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Cache TTL (segundos) ---
CACHE_TTL_QUOTE=300          # cotações: 5 min
CACHE_TTL_CRYPTO=120         # cripto: 2 min
CACHE_TTL_CURRENCY=600       # câmbio: 10 min
CACHE_TTL_TREASURY=3600      # tesouro direto: 1 hora
CACHE_TTL_MACRO=21600        # CDI/IPCA/SELIC: 6 horas
