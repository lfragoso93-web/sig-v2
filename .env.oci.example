# SGI v2 - OCI Always Free production example
# Copy to .env on the VM and fill with real values there only.
# Do not commit the real .env file.

ENVIRONMENT=production
APP_DEBUG=false
APP_PORT=80
BACKEND_PORT=8000
BACKEND_WORKERS=1

# APP_COMMIT_SHA is immutable image metadata, not VM environment configuration.
# Inject the deployed HEAD only while building the backend image, for example:
# APP_COMMIT_SHA="$(git rev-parse HEAD)" docker compose build backend

# Empty keeps the browser using the same host and nginx proxying /api.
VITE_API_URL=

POSTGRES_USER=sgi
POSTGRES_PASSWORD=change-this-on-vm
POSTGRES_DB=sgi
DATABASE_URL=postgresql://sgi:change-this-on-vm@db:5432/sgi
ASYNC_DATABASE_URL=postgresql+asyncpg://sgi:change-this-on-vm@db:5432/sgi

REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Production gates reject the default local values.
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=https://your-sgi-hostname.example
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute

SUPERADMIN_EMAIL=admin@your-domain.example
SUPERADMIN_PASSWORD=replace-with-a-strong-password
SUPERADMIN_NAME=Super Admin

BRAPI_TOKEN=
BRAPI_BASE_URL=https://brapi.dev/api
BRAPI_RATE_LIMIT=2.0
BRAPI_RATE_BURST=5
ALPHA_VANTAGE_API_KEY=

QUOTES_PROVIDER_TOKEN=
MARKET_DATA_BASE_URL=
MARKET_DATA_RATE_LIMIT=2.0
MARKET_DATA_RATE_BURST=5
INTL_DATA_KEY=

ENABLE_BOOT_MARKET_SYNC=false
SGI_BOOTSTRAP_COMMIT_SHA=
SGI_BOOTSTRAP_ENABLE_DIVIDENDS=false
SGI_BOOTSTRAP_ENABLE_CORPORATE_EVENTS=false

PRE_PROD_BRANCH=stable-15jun
PRE_PROD_COMMIT_SHA=
PRE_PROD_RESTORE_DATABASE_URL=
PRE_PROD_SYNC_DATABASE_URL=

# Create the tunnel token in Cloudflare and paste it only on the VM.
CLOUDFLARE_TUNNEL_TOKEN=
