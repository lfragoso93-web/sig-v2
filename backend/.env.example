# =============================================================
# SGI v2 — Exemplo de variaveis de ambiente
# Copie para .env e preencha os valores reais
# NUNCA commite o .env com dados reais
# =============================================================

# ── Banco de dados ──────────────────────────────────────────────
DATABASE_URL=postgresql://sgi:sgi@db:5432/sgi
ASYNC_DATABASE_URL=postgresql+asyncpg://sgi:sgi@db:5432/sgi

# ── JWT ───────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Superadmin seed ────────────────────────────────────────
SUPERADMIN_EMAIL=admin@sig.local
SUPERADMIN_PASSWORD=Admin@1234!
SUPERADMIN_NAME=Super Admin

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Redis (opcional) ───────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ── BRAPI (cotacoes) ──────────────────────────────────────
BRAPI_TOKEN=seu_token_aqui
BRAPI_BASE_URL=https://brapi.dev/api
BRAPI_RATE_LIMIT=2.0
BRAPI_RATE_BURST=5

# ── Rate limiting de endpoints publicos (slowapi) ─────────────────
# Formato: "N/period" onde period = second | minute | hour
# O limiter usa Redis (REDIS_URL) se disponivel; fallback para memoria.
# NUNCA zere esses limites em producao.
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute

# Rate limiting do router de debug
# Mais restritivo — endpoints criticos (reset senha, criar usuario)
# Para desativar o router completamente: remover ADMIN_SECRET do .env
DEBUG_RATE_LIMIT=5/minute

# ── Debug router (habilita /api/v1/debug/*) ───────────────────
# Processo de ativacao/desativacao:
#   Ativar:   definir ADMIN_SECRET com valor seguro e fazer redeploy
#   Desativar: remover (ou comentar) ADMIN_SECRET e fazer redeploy
#   Remover permanentemente: apagar debug.py + include_router em main.py
#
# NUNCA definir ADMIN_SECRET em producao sem necessidade operacional ativa.
# ADMIN_SECRET=apenas_em_dev_ou_operacao_pontual

# ── Debug (traceback na resposta) ───────────────────────────
# false: erros retornam mensagem generica (producao)
# true:  traceback completo na resposta JSON (desenvolvimento apenas)
APP_DEBUG=false
