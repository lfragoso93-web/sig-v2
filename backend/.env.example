# =============================================================
# SGI v2 — Exemplo de variáveis de ambiente
# Copie para .env e preencha os valores reais
# NUNCA commite o .env com dados reais
# =============================================================

# ── Banco de dados ────────────────────────────────────────────
DATABASE_URL=postgresql://sgi:sgi@db:5432/sgi
ASYNC_DATABASE_URL=postgresql+asyncpg://sgi:sgi@db:5432/sgi

# ── JWT ───────────────────────────────────────────────────────
# Gere uma chave segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Superadmin seed ───────────────────────────────────────────
# Criado/atualizado automaticamente a cada startup do servidor
# Troque para credenciais seguras antes de subir em produção!
SUPERADMIN_EMAIL=admin@sig.local
SUPERADMIN_PASSWORD=Admin@1234!
SUPERADMIN_NAME=Super Admin

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Redis (opcional) ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ── BRAPI (cotações) ─────────────────────────────────────────
BRAPI_TOKEN=seu_token_aqui
BRAPI_BASE_URL=https://brapi.dev/api

# ── Debug ─────────────────────────────────────────────────────
APP_DEBUG=false

# ── Admin secret (habilita rotas /debug) ─────────────────────
# ADMIN_SECRET=apenas_em_dev
